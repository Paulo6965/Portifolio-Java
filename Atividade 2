import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
	Scanner sc = new Scanner(System.in); 
	
	System.out.print("Digite aqui à quantidade de Km percorridos ");
    Double DistKm = sc.nextDouble();
    
    Double DistM = DistKm * 1000;
    Double DistMI = DistKm * 0.621;
    System.out.print("Quanto tempo voce demorou em minutos? ");
    int tempo = sc.nextInt();
    Double Velo = DistM / tempo;
    System.out.print("Voce andou " +DistKm+ " KM " +DistM+ " metros " +DistMI+ " milhas e sua velocidade media foi " +Velo+ " m/min!");
    }
}

